cartPayone = PAGE
cartPayone {
    typeNum = {$plugin.tx_cartpayone.redirectTypeNum}

    config {
        disableAllHeaderCode = 1
        xhtml_cleaning = 0
        admPanel = 0
        debug = 0
        no_cache = 1
    }

    10 = EXTBASEPLUGIN
    10.extensionName = CartPayone
    10.pluginName = Cart
}

plugin.tx_cartpayone {
    sandbox = 1

    redirectTypeNum = {$plugin.tx_cartpayone.redirectTypeNum}

    request = authorization
}
